# Copy this file to `.env` and adjust values if you want to override
# the defaults. None of these are required to run the app locally --
# config.py already falls back to sensible built-in defaults, so the
# project runs out of the box with no `.env` file at all.

# --- Flask ---
SECRET_KEY=change-this-in-production
FLASK_DEBUG=True

# --- Currency shown throughout the site ---
CURRENCY_CODE=PKR
CURRENCY_SYMBOL=PKR

# --- Supported live-prediction range, in square yards ---
MIN_PREDICTION_SQYD=120
MAX_PREDICTION_SQYD=10000

# --- Synthetic dataset size (rows generated by ml/generate_dataset.py) ---
N_SAMPLES=600
